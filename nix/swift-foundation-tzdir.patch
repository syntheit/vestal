+                    // Nix: /etc/localtime points into another zoneinfo
+                    // directory than TZDIR (NixOS: /etc/zoneinfo/Area/City);
+                    // the name is what follows "/zoneinfo/".
+                    if let rangeOfZoneInfo = file._range(of: "/zoneinfo/", anchored: false, backwards: false) {
+                        let name = file[rangeOfZoneInfo.upperBound...]
+                        if !name.isEmpty, let result = fixed(String(name)) {
+                            return TimeZone(inner: result)
+                        }
+                    }
                 }
             }
             

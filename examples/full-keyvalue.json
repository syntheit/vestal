{
  "version": 1,
  "hotkey": null,
  "theme": {
    "palette": "tokyo-night",
    "background": "aurora"
  },
  "sources": {
    "weather": {
      "type": "http",
      "url": "https://wttr.in/Lisbon?m&format=j1",
      "refresh": "30m"
    },
    "rates": {
      "type": "http",
      "url": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR,GBP,JPY",
      "refresh": "4h"
    },
    "calendar": {
      "type": "calendar",
      "refresh": "5m",
      "days": 1
    }
  },
  "widgets": {
    "clock": {
      "type": "clock",
      "worldClocks": [
        {
          "label": "LIS",
          "tz": "Europe/Lisbon"
        },
        {
          "label": "NYC",
          "tz": "America/New_York"
        },
        {
          "label": "TYO",
          "tz": "Asia/Tokyo"
        }
      ]
    },
    "systemBar": {
      "type": "systemBar",
      "show": [
        "uptime",
        "disk",
        "battery",
        "claudeUsage",
        "network",
        "privacy"
      ],
      "privacy": {
        "command": [
          "bash",
          "~/bin/toggle-privacy"
        ],
        "stateFile": "~/.cache/privacy-mode"
      }
    },
    "claude": { "type": "claudeUsage" },
    "media": null,
    "spotify": {
      "type": "media",
      "player": "Spotify",
      "hideWhenOff": true
    },
    "agenda": {
      "type": "agendaList",
      "title": "Today",
      "source": "calendar",
      "maxEvents": 5
    },
    "systems": {
      "type": "systemHealth",
      "hosts": [
        {
          "name": "atlas",
          "source": "local"
        },
        {
          "name": "nas",
          "url": "https://nas.example.com"
        },
        {
          "name": "edge",
          "url": "https://edge.example.com"
        },
        {
          "name": "backup",
          "url": "https://backup.example.com"
        }
      ]
    },
    "exchange": {
      "type": "section",
      "title": "Currencies",
      "spaceBefore": 24,
      "children": [
        {
          "type": "keyValue",
          "source": "rates",
          "items": [
            {
              "label": "EUR",
              "value": ".rates.EUR",
              "format": "fixed:2"
            },
            {
              "label": "GBP",
              "value": ".rates.GBP",
              "format": "fixed:2"
            },
            {
              "label": "JPY",
              "value": ".rates.JPY",
              "format": "fixed:2"
            }
          ]
        }
      ]
    },
    "weather": {
      "type": "weatherCard",
      "source": "weather",
      "fields": {
        "location": ".nearest_area[0].areaName[0].value",
        "region": ".nearest_area[0].region[0].value",
        "condition": ".current_condition[0].weatherDesc[0].value",
        "temp": ".current_condition[0].temp_C",
        "sunrise": ".weather[0].astronomy[0].sunrise",
        "sunset": ".weather[0].astronomy[0].sunset"
      }
    }
  },
  "views": {
    "main": {
      "children": [
        "clock",
        "systemBar",
        "spotify",
        "agenda",
        "systems",
        "exchange",
        "weather"
      ]
    }
  }
}
